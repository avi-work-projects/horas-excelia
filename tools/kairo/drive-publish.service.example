# Install only after OAuth, remote folder verification and end-to-end probe.
[Unit]
Description=Publish verified Kairo invoice PDFs to Drive
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=angel
WorkingDirectory=/home/angel/gestify-facturacion
ExecStart=/home/angel/gestify-facturacion/venv/bin/python drive_publish.py
UMask=0077
NoNewPrivileges=true
Restart=on-failure
# systemd >=254: 15m, about 69m, about 5h15m, then at most once a day.
RestartSec=900
RestartSteps=3
RestartMaxDelaySec=24h

[Install]
WantedBy=multi-user.target
