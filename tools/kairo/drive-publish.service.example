# Install only after OAuth, remote folder verification and end-to-end probe.
[Unit]
Description=Publish verified Kairo invoice PDFs to Drive
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=angel
WorkingDirectory=/home/angel/gestify-facturacion
ExecStart=/home/angel/gestify-facturacion/venv/bin/python drive_publish.py
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=900

[Install]
WantedBy=multi-user.target
